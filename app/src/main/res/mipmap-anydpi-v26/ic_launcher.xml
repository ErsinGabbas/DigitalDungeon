<?xml version="1.0" encoding="utf-8"?>
<!--
    No <monochrome> layer on purpose. Android 13 themed icons expect a flat silhouette that
    the system recolours; handing it this detailed full-colour artwork would render as a dark
    blob. A proper monochrome layer has to be drawn, not derived.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
