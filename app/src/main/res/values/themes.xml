    <!--
        The whole UI is Compose; colors live in ui/theme/Theme.kt.
        This theme only styles the window before the first frame, so it stays
        minimal: no action bar, and no status bar color (edge-to-edge draws
        behind transparent system bars).
    -->
    <style name="Theme.DigitalDungeon" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
